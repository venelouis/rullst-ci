new file mode 100644
index 0000000..2e138d4
--- /dev/null
+++ b/rullst-core/src/ablate.rs
@@ -0,0 +1,23 @@
+//! Measurement instrument for the 13.1 performance investigation (Rullst issue
+//! #832, phase 1). `RULLST_ABLATE` is a comma-separated list of stack parts
+//! the process skips: `install`, `headers`, `cookies`, `waf`, `csrf`, `vary`,
+//! `connectinfo`. It exists only in the scratch build the investigation
+//! measures and is not part of any release.
+
+use std::sync::OnceLock;
+
+fn parts() -> &'static [String] {
+    static PARTS: OnceLock<Vec<String>> = OnceLock::new();
+    PARTS.get_or_init(|| {
+        std::env::var("RULLST_ABLATE")
+            .unwrap_or_default()
+            .split(',')
+            .map(|part| part.trim().to_string())
+            .filter(|part| !part.is_empty())
+            .collect()
+    })
+}
+
+pub(crate) fn has(name: &str) -> bool {
+    parts().iter().any(|part| part == name)
+}
